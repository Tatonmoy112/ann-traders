NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Server/build-time: production HTTPS custom delivery domain; r2.dev is development only.
R2_PUBLIC_BASE_URL=
# Set development only when explicitly testing r2.dev media locally.
# Production: R2_ENVIRONMENT=production and an HTTPS custom delivery domain.
R2_ENVIRONMENT=development
CATALOG_CONTACT_EMAIL=
# International digits, e.g. country code followed by the verified business number.
CATALOG_WHATSAPP_NUMBER=
# Preview-only, clearly labeled demo contact details. Keep false for real contacts.
CATALOG_DEMO_CONTACTS=false
# Operator-only manual cache purge. Never NEXT_PUBLIC_.
INTERNAL_CATALOG_REVALIDATE_SECRET=
# auto trusts Vercel's IP header only when the VERCEL=1 system variable exists.
# Shared enforcement still requires a Vercel Firewall rate-limit rule.
CLIENT_TRUSTED_PROXY=auto
# Only for a separately authenticated Cloudflare/nginx origin; unused on Vercel.
CLIENT_PROXY_ORIGIN_SECRET=
PORT=3001
# Enable after deploying and verifying the read-only catalog-document Edge function.
CATALOG_PUBLIC_DOCUMENT_DOWNLOADS=false
