NEXT_PUBLIC_SUPABASE_URL= https://eoyrjacticdvkzzvibay.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UFRVdfFU3uizvdygUgdpOw_XcCzgIZE
# This root example is for the ADMIN deployment. Configure the read-only public
# app from apps/client/.env.example; never give it the service-role/R2 credentials.
APP_ORIGIN=http://localhost:3000
# Explicit local development; use production + cloudflare before launch.
R2_ENVIRONMENT=development
R2_CDN_PURGE_MODE=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# Development: https://pub-<public-bucket-id>.r2.dev (PUBLIC bucket only).
# Production: https://images.your-domain.example
# Optional explicitly trusted former delivery origins, comma-separated, after domain cutover.
R2_PREVIOUS_PUBLIC_BASE_URLS=
# Optional local emulator only; production derives the account endpoint.
R2_ENDPOINT=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
# Retain only while legacy Images records/jobs still exist.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
# Edge worker secret, configured separately in the Edge runtime.
CATALOG_WORKER_SECRET=
SENTRY_DSN=
INTERNAL_CATALOG_REVALIDATE_SECRET=
# Optional operator-only hosted staging preflight; not used by the admin runtime.
# Copy the real Session pooler URL from Supabase Connect (5432) on IPv4-only networks.
DATABASE_URL=
SUPABASE_DB_PASSWORD=
# Optional explicit overrides when the app itself still points at local Supabase.
STAGING_DATABASE_URL=
STAGING_SUPABASE_URL=
# Optional path to a trusted project CA certificate; certificate validation stays enabled.
STAGING_DATABASE_CA_CERT=
